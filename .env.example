# .env.example - Kopiere diese Datei zu .env und ergänze deine Token.
# Achte darauf, dass lokale LLMs nur auf dem eigenen PC aktiv sind.

# Telegram Bot Token (von @BotFather in Telegram)
TELEGRAM_BOT_TOKEN=dein_token_hier

# Optional: Local LLM fallback (disabled by default)
# Use this with a model running locally, for example via Ollama.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_TIMEOUT=30.0

# Optional: comma-separated public frontend origins for /api/chat CORS.
# Leave empty when the frontend is served by the same backend.
CHAT_ALLOWED_ORIGINS=https://hogwarts108-droid.github.io

# Optional: remote OpenAI API key kept disabled unless explicitly needed
# OPENAI_API_KEY=sk-...
